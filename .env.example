NODE_ENV=development
PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/jobflow
REDIS_URL=redis://127.0.0.1:6379
CLIENT_ORIGINS=http://localhost:5173
JWT_ACCESS_SECRET=replace-this-with-a-long-random-string
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
COOKIE_SECURE=false
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
MAIL_FROM=JobFlow <no-reply@localhost>

# Optional. Without these, reset and verify links are printed in the server log
# and returned in the JSON response only when NODE_ENV is not production.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# Optional. Job description parsing uses local rules unless this is set.
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
